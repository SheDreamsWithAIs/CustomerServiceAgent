# Backend configuration
PROJECT_NAME=OfficeLifeline
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Providers (wire now, use later)
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-4o-mini

AWS_REGION=us-east-1
BEDROCK_ENABLED=false
# Example model hint; exact names will be configured later
BEDROCK_MODEL=bedrock:anthropic:haiku

# Vector store
CHROMA_PERSIST_DIRECTORY=.chroma
CHROMA_COLLECTION=office_lifeline_kb

